<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SmartAgri.Domain\SmartAgri.Domain.csproj" />
    <!-- Implements Application's abstractions (e.g. IDocumentTextExtractor), M2 plan §3. -->
    <ProjectReference Include="..\SmartAgri.Application\SmartAgri.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- IDataProtectionProvider for DataProtectionSecretProtector (M5a Slice 1). Part of the
         shared framework, not a NuGet package: the Api already runs on it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <!-- Text extraction (M2 Slice 6): PdfPig (Apache-2.0) for PDF, Open XML SDK (MIT) for
         DOCX/XLSX, per the assistant-access ADR. Infrastructure only (M2 plan §3). -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <!-- Embeddings and vectors (M2 Slice 7): the official OpenAI client (OpenAI, Azure OpenAI's
         v1 endpoint and OpenAI-compatible servers) behind Microsoft.Extensions.AI's
         IEmbeddingGenerator (llm-providers ADR); VectorData's VectorStoreCollection implemented
         on EF Core + Pgvector.EntityFrameworkCore instead of the preview connector
         (postgresql-as-single-store ADR). All MIT. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <!-- Chat models (M3 Slice 4): ChatClientBuilder/ConfigureOptions apply the deployment's
         default max output tokens to the configured IChatClient (llm-providers ADR). Only the
         full Microsoft.Extensions.AI package has the builder; Application only ever sees
         IChatClient from Microsoft.Extensions.AI.Abstractions. -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Pgvector" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmartAgri.Api.Tests" />
  </ItemGroup>

</Project>
