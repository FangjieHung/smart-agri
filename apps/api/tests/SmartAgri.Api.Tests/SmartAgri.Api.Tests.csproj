<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!--
      Same version-conflict fix as SmartAgri.Api.csproj: Microsoft.AspNetCore.Mvc.Testing
      pulls in the ASP.NET Core shared framework's lower compile-time reference assembly,
      which would otherwise win over the version SmartAgri.Infrastructure needs.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- In-memory exporter for OpenTelemetryTracingTests; not used by the app itself. -->
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartAgri.Api\SmartAgri.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Knowledge extraction fixtures (M2 Slice 6), read by KnowledgeFixtures; how each was
         made and its font licence: ../fixtures/knowledge/README.md. -->
    <None Include="..\fixtures\knowledge\*" Exclude="..\fixtures\knowledge\README.md;..\fixtures\knowledge\.gitattributes" LinkBase="fixtures\knowledge" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
