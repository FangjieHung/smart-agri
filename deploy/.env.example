# Copy this file to deploy/.env and fill in real values before running
# `docker compose -f deploy/docker-compose.yml up --build`.
# Do NOT commit deploy/.env — it is only an example, no secrets belong in this file.
# Step-by-step deployment and website-embedding guide (Traditional Chinese, for operators): deploy/README.md.

# Shared by both compose files.
POSTGRES_DB=smartagri
POSTGRES_USER=smartagri
# Required by deploy/docker-compose.yml (the customer-deploy compose). Not required by
# deploy/docker-compose.dev.yml, which defaults to smartagri_dev to match
# apps/api/src/SmartAgri.Api/appsettings.Development.json.
POSTGRES_PASSWORD=

# deploy/docker-compose.yml (customer deploy) only.
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080

# Sign-in (deploy/docker-compose.yml only). Token certificates go in deploy/certs/
# (signing.pfx, encryption.pfx); see apps/api/README.md, "Sign-in and tokens".
AUTH_SIGNING_CERTIFICATE_PASSWORD=
AUTH_ENCRYPTION_CERTIFICATE_PASSWORD=
# Data Protection key ring (deploy/docker-compose.yml only; apps/api/README.md, "Data
# Protection key ring"). The keys live in the volume smartagri-dataprotection-keys and are
# encrypted with deploy/certs/dataprotection.pfx (chmod 644: the api runs as a non-root user and
# refuses to start when it cannot read it). Back up the volume, the certificate and the database
# together; without the keys, stored secret settings must be entered again and every sign-in and
# visitor token stops working.
DATA_PROTECTION_CERTIFICATE_PASSWORD=
# e.g. https://admin.example.org — the origin the admin SPA is served from.
ADMIN_SPA_ORIGIN=

# Embedding model (deploy/docker-compose.yml only; apps/api/README.md, "Embeddings and vector
# search"). OpenAI, AzureOpenAI or OpenAICompatible; Fake is refused outside Development.
# Anthropic has no embeddings API, so a Claude deployment still needs one of these.
# Changing EMBEDDING_MODEL later requires `docker compose ... run --rm api reindex`.
EMBEDDING_PROVIDER=
# Azure: https://{resource}.openai.azure.com/openai/v1/ ; vLLM etc.: http://host:8000/v1
EMBEDDING_ENDPOINT=
# e.g. text-embedding-3-small (Azure: the deployment name)
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# e.g. "passage: " and "query: " for the e5 family; empty for OpenAI models.
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_QUERY_PREFIX=

# Chat model (deploy/docker-compose.yml only; apps/api/README.md, "Chat model"). OpenAI,
# AzureOpenAI or OpenAICompatible; Fake is refused outside Development. Leave CHAT_PROVIDER
# empty and the api still starts, but every conversation answers 503 chat-not-configured.
CHAT_PROVIDER=
# Azure: https://{resource}.openai.azure.com/openai/v1/ (required); vLLM etc.: http://host:8000/v1
# (required); OpenAI: optional.
CHAT_ENDPOINT=
# Required with a provider, e.g. gpt-4o-mini (Azure: the deployment name).
CHAT_MODEL=
# Required for OpenAI and AzureOpenAI. Never commit a real key.
CHAT_API_KEY=
# Optional caps; empty = the provider's / client's default (blank is fine, it does not fail startup).
CHAT_MAX_OUTPUT_TOKENS=
CHAT_TIMEOUT_SECONDS=
# None, Low, Medium, High or ExtraHigh; empty = the provider's default. Reasoning models
# (for example gpt-6-luna) MUST use None: otherwise they refuse function tools and both the
# record-query tools (#149) and the form tool (#164) fail with HTTP 400.
CHAT_REASONING_EFFORT=
# Optional: the default model's id (stored as an organization's choice; set it before any
# organization chooses a model and do not change it later) and the name shown in the settings.
# Empty = the model name.
CHAT_ID=
CHAT_DISPLAY_NAME=

# Optional second chat model (M6; deploy/README.md, section 11). The CHAT_* model above is the
# deployment default every organization uses until its manager picks another one in 系統設定.
# Leave CHAT_MODELS_0_PROVIDER empty and the whole entry is skipped (one model, as before).
# Each value means the same as its CHAT_* counterpart above; the entry has its own key, caps
# and reasoning effort. gpt-5.6-terra, like gpt-6-luna, needs CHAT_MODELS_0_REASONING_EFFORT=None
# or the form and record-query tools fail with HTTP 400.
CHAT_MODELS_0_PROVIDER=
CHAT_MODELS_0_ENDPOINT=
CHAT_MODELS_0_MODEL=
CHAT_MODELS_0_API_KEY=
# Required when CHAT_MODELS_0_MODEL equals CHAT_MODEL (two settings of one model need two ids);
# letters, digits, - _ . only. Empty = the model name.
CHAT_MODELS_0_ID=
# e.g. gpt-5.6-terra（進階）. Empty = the model name.
CHAT_MODELS_0_DISPLAY_NAME=
CHAT_MODELS_0_MAX_OUTPUT_TOKENS=
CHAT_MODELS_0_TIMEOUT_SECONDS=
CHAT_MODELS_0_REASONING_EFFORT=

# Model (default here): the chat model decides whether a question gets the assistant's form;
# if the model call fails, or no chat model is configured, the keyword gate decides instead
# (the form still appears when the member asks for it in so many words). Keyword: keyword gate
# only, no extra model call. Model costs one extra small call per question for assistants
# that have a form (docs/evals/2026-10-05-164-form-request-trigger.md, section 5).
CHAT_FORM_REQUEST_TRIGGER=Model
# IANA time zone for the statistics queries and periodic reports (calendar days, week start).
STATISTICS_TIME_ZONE=Asia/Taipei

# Website channel (deploy/docker-compose.yml only; apps/api/README.md, "Website channel"): the
# address visitors' browsers reach the api at, e.g. https://assistant.example.org. The embed code
# customers paste loads {PUBLIC_BASE_URL}/embed.js. Leave empty and the api still starts, but
# website channels cannot be published (422 public-base-url).
PUBLIC_BASE_URL=
# Chat-model tokens (input + output) an organization may use per calendar month before its website
# replies are suspended, unless an operator gave it its own limit with
# `docker compose -f deploy/docker-compose.yml --env-file deploy/.env run --rm api set-token-limit
# --organization <code> --tokens <n>|default` (apps/api/README.md, "Monthly token limit"). Empty =
# the built-in 2000000; 0 suspends every organization without its own limit.
DEFAULT_MONTHLY_TOKEN_LIMIT=
# The reverse proxy in front of the api (nginx, a load balancer, a CDN): IP addresses and/or CIDR
# networks, comma separated, e.g. 172.18.0.0/16,10.0.0.5. Only requests from them have X-Forwarded-For
# (the visitor's real IP, which the website channel's rate limits count by), -Proto and -Host applied.
# Leave empty when visitors reach the api directly. Behind a proxy it MUST be set: otherwise every
# visitor shares the proxy's IP and is rate-limited (429) together (apps/api/README.md, "Behind a reverse proxy").
# A proxy that ends TLS also needs it so the api sees https (X-Forwarded-Proto).
TRUSTED_PROXIES=
# The visitor API's rate limits (PublicChannels__RateLimits__*) have sensible defaults and are not
# read from this file; to change them, see deploy/README.md, section 3 (a second compose file).

# Development-only demo seed data (see apps/api/README.md, "Development seed data").
# Neither compose file above reads this: deploy/docker-compose.yml always runs
# ASPNETCORE_ENVIRONMENT=Production, where DevelopmentSeeder is never even registered, so
# it can never seed a customer deployment no matter what this is set to. Optional: leave
# it unset (the default here) and `migrate` in Development just logs a warning and skips
# seeding — that's what you want for the local `setup` flow, which needs an
# organization-less database. Set it in your own shell (never in a checked-in file —
# tools/check-no-demo-secrets.sh fails CI on a real value here) before running
# `dotnet run --project apps/api/src/SmartAgri.Api -- migrate` in Development to get the
# three demo accounts instead. When set, it must satisfy the same Identity password rules
# as a real account (AuthenticationServiceCollectionExtensions.AddSmartAgriAuthentication's
# IdentityOptions.Password — currently at least 12 characters, with an upper-case letter, a
# lower-case letter, a digit and a symbol; see apps/api/README.md, "Development seed data",
# for the current values) — migrate exits non-zero, before creating anything, if it does not.
SEED_DEMO_PASSWORD=
