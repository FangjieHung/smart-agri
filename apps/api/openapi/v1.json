{
  "openapi": "3.1.1",
  "info": {
    "title": "SmartAgri API",
    "version": "v1"
  },
  "paths": {
    "/api/v1/auth/change-password": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "MeEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/login-options": {
      "get": {
        "tags": [
          "AuthEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginOptionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/team": {
      "get": {
        "tags": [
          "TeamEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/v1/team/members/{id}/permissions": {
      "put": {
        "tags": [
          "TeamEndpoints"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMemberPermissionsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/v1/knowledge-bases": {
      "get": {
        "tags": [
          "KnowledgeBaseEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/KnowledgeBaseSummaryView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "KnowledgeBaseEndpoints"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateKnowledgeBaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeBaseSummaryView"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/v1/knowledge-bases/{id}": {
      "get": {
        "tags": [
          "KnowledgeBaseEndpoints"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeBaseDetailView"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      },
      "patch": {
        "tags": [
          "KnowledgeBaseEndpoints"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateKnowledgeBaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeBaseSummaryView"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      },
      "delete": {
        "tags": [
          "KnowledgeBaseEndpoints"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/v1/knowledge-bases/{id}/sharing": {
      "put": {
        "tags": [
          "KnowledgeBaseEndpoints"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateKnowledgeSharingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeSharingView"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountPermission": {
        "enum": [
          "manage-assistants",
          "manage-data-sources",
          "manage-publishing",
          "read-consented-submissions",
          "use-shared-assistants",
          "submit-authorized-forms",
          "read-own-tracking"
        ]
      },
      "AccountRole": {
        "enum": [
          "smb-admin",
          "internal-employee",
          "external-customer"
        ]
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": [
              "null",
              "string"
            ]
          },
          "newPassword": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateKnowledgeBaseRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "purpose": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "KnowledgeBaseDetailView": {
        "required": [
          "summary",
          "documents",
          "sharing",
          "shareTargets"
        ],
        "type": "object",
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/KnowledgeBaseSummaryView"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KnowledgeDocumentView"
            }
          },
          "sharing": {
            "$ref": "#/components/schemas/KnowledgeSharingView"
          },
          "shareTargets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KnowledgeShareTargetView"
            }
          }
        }
      },
      "KnowledgeBaseSummaryView": {
        "required": [
          "id",
          "name",
          "purpose",
          "documentCount",
          "faqCount",
          "statusCounts",
          "sharingScope",
          "updatedAt",
          "viewerCanManage"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "documentCount": {
            "type": "integer",
            "format": "int32"
          },
          "faqCount": {
            "type": "integer",
            "format": "int32"
          },
          "statusCounts": {
            "$ref": "#/components/schemas/KnowledgeDocumentStatusCounts"
          },
          "sharingScope": {
            "$ref": "#/components/schemas/KnowledgeSharingScope"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "viewerCanManage": {
            "type": "boolean"
          }
        }
      },
      "KnowledgeDocumentStatus": {
        "enum": [
          "queued",
          "processing",
          "ready",
          "partially-readable",
          "failed"
        ]
      },
      "KnowledgeDocumentStatusCounts": {
        "required": [
          "queued",
          "processing",
          "ready",
          "partially-readable",
          "failed"
        ],
        "type": "object",
        "properties": {
          "queued": {
            "type": "integer",
            "format": "int32"
          },
          "processing": {
            "type": "integer",
            "format": "int32"
          },
          "ready": {
            "type": "integer",
            "format": "int32"
          },
          "partially-readable": {
            "type": "integer",
            "format": "int32"
          },
          "failed": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "KnowledgeDocumentView": {
        "required": [
          "id",
          "kind",
          "name",
          "status",
          "issue",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/KnowledgeItemKind"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/KnowledgeDocumentStatus"
          },
          "issue": {
            "type": [
              "null",
              "string"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "KnowledgeItemKind": {
        "enum": [
          "document",
          "faq"
        ]
      },
      "KnowledgeShareTargetView": {
        "required": [
          "id",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "KnowledgeSharingScope": {
        "enum": [
          "private",
          "specific-accounts",
          "public"
        ]
      },
      "KnowledgeSharingView": {
        "required": [
          "scope",
          "sharedWithAccountIds",
          "allowOriginalDownload"
        ],
        "type": "object",
        "properties": {
          "scope": {
            "$ref": "#/components/schemas/KnowledgeSharingScope"
          },
          "sharedWithAccountIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "allowOriginalDownload": {
            "type": "boolean"
          }
        }
      },
      "LoginOptionsResponse": {
        "required": [
          "organizationCodeRequired"
        ],
        "type": "object",
        "properties": {
          "organizationCodeRequired": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "organizationCode",
          "loginName",
          "password"
        ],
        "type": "object",
        "properties": {
          "organizationCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "loginName": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MeOrganization": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "id",
          "displayName",
          "role",
          "permissions",
          "organization",
          "passwordChangeRequired"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AccountRole"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountPermission"
            }
          },
          "organization": {
            "$ref": "#/components/schemas/MeOrganization"
          },
          "passwordChangeRequired": {
            "type": "boolean"
          }
        }
      },
      "TeamMemberResponse": {
        "required": [
          "id",
          "displayName",
          "role",
          "permissions",
          "lockedPermissions"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AccountRole"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountPermission"
            }
          },
          "lockedPermissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountPermission"
            }
          }
        }
      },
      "TeamResponse": {
        "required": [
          "members",
          "savedAt"
        ],
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamMemberResponse"
            }
          },
          "savedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "UpdateKnowledgeBaseRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "purpose": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateKnowledgeSharingRequest": {
        "required": [
          "scope",
          "sharedWithAccountIds",
          "allowOriginalDownload"
        ],
        "type": "object",
        "properties": {
          "scope": {
            "type": [
              "null",
              "string"
            ]
          },
          "sharedWithAccountIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "allowOriginalDownload": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "UpdateMemberPermissionsRequest": {
        "required": [
          "permissions"
        ],
        "type": "object",
        "properties": {
          "permissions": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "AuthEndpoints"
    },
    {
      "name": "MeEndpoints"
    },
    {
      "name": "TeamEndpoints"
    },
    {
      "name": "KnowledgeBaseEndpoints"
    }
  ]
}