# The api image is built with the repo root as context (deploy/docker-compose.yml);
# send only what the Dockerfile copies: the api's sources, and for the Node stage that builds the
# widget (M5a #201) and the admin (#306) the workspace files (with .postcssrc.json, Tailwind for the
# admin), apps/widget, apps/admin, libs and the embed loader. Specs stay out: no build reads them.
*
!global.json
!apps/api/Directory.Build.props
!apps/api/Directory.Packages.props
!apps/api/src
!package.json
!package-lock.json
!.npmrc
!nx.json
!tsconfig.base.json
!.postcssrc.json
!apps/widget
!apps/admin
!libs
!apps/embed-loader/src/embed.js
**/bin
**/obj
**/node_modules
**/dist
**/*.spec.ts
