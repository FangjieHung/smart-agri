{
  "openapi": "3.1.1",
  "info": {
    "title": "SmartAgri API",
    "version": "v1"
  },
  "paths": {
    "/api/v1/auth/change-password": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "MeEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/login-options": {
      "get": {
        "tags": [
          "AuthEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginOptionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/team": {
      "get": {
        "tags": [
          "TeamEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/v1/team/members/{id}/permissions": {
      "put": {
        "tags": [
          "TeamEndpoints"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMemberPermissionsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Unprocessable Entity"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountPermission": {
        "enum": [
          "manage-assistants",
          "manage-data-sources",
          "manage-publishing",
          "read-consented-submissions",
          "use-shared-assistants",
          "submit-authorized-forms",
          "read-own-tracking"
        ]
      },
      "AccountRole": {
        "enum": [
          "smb-admin",
          "internal-employee",
          "external-customer"
        ]
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": [
              "null",
              "string"
            ]
          },
          "newPassword": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LoginOptionsResponse": {
        "required": [
          "organizationCodeRequired"
        ],
        "type": "object",
        "properties": {
          "organizationCodeRequired": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "organizationCode",
          "loginName",
          "password"
        ],
        "type": "object",
        "properties": {
          "organizationCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "loginName": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MeOrganization": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "id",
          "displayName",
          "role",
          "permissions",
          "organization",
          "passwordChangeRequired"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AccountRole"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountPermission"
            }
          },
          "organization": {
            "$ref": "#/components/schemas/MeOrganization"
          },
          "passwordChangeRequired": {
            "type": "boolean"
          }
        }
      },
      "TeamMemberResponse": {
        "required": [
          "id",
          "displayName",
          "role",
          "permissions",
          "lockedPermissions"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/AccountRole"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountPermission"
            }
          },
          "lockedPermissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountPermission"
            }
          }
        }
      },
      "TeamResponse": {
        "required": [
          "members",
          "savedAt"
        ],
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamMemberResponse"
            }
          },
          "savedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "UpdateMemberPermissionsRequest": {
        "required": [
          "permissions"
        ],
        "type": "object",
        "properties": {
          "permissions": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "AuthEndpoints"
    },
    {
      "name": "MeEndpoints"
    },
    {
      "name": "TeamEndpoints"
    }
  ]
}