{
  "name": "shop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/shop/src",
  "prefix": "app",
  "tags": ["scope:shop"],
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath}"],
      "options": {
        "browser": "apps/shop/src/main.ts",
        "tsConfig": "apps/shop/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "styles": ["apps/shop/src/styles.scss"],
        "outputPath": "dist/smart-agri-shop"
      },
      "configurations": {
        "production": {
          "baseHref": "/order/",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "200kB",
              "maximumError": "260kB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kB",
              "maximumError": "10kB"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "baseHref": "/order/",
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/shop/proxy.api.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "shop:build:production"
        },
        "development": {
          "buildTarget": "shop:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "api-types": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["SmartAgri.Api:build"],
      "inputs": [
        "{workspaceRoot}/apps/api/openapi/v1.json",
        {
          "externalDependencies": ["openapi-typescript"]
        }
      ],
      "outputs": ["{projectRoot}/src/app/api/api-schema.ts"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "openapi-typescript apps/api/openapi/v1.json -o apps/shop/src/app/api/api-schema.ts"
      }
    }
  }
}
