{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/admin/src",
  "prefix": "app",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "defaultConfiguration": "production",
      "outputs": ["{options.outputPath}"],
      "options": {
        "browser": "apps/admin/src/main.ts",
        "tsConfig": "apps/admin/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "libs/assets/image"
          }
        ],
        "styles": ["apps/admin/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs"]
        },
        "outputPath": "dist/smart-agri-admin"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kB",
              "maximumError": "1MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kB",
              "maximumError": "10kB"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "api": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/admin/src/environments/environment.ts",
              "with": "apps/admin/src/environments/environment.api.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "admin:build:production"
        },
        "development": {
          "buildTarget": "admin:build:development"
        },
        "api": {
          "buildTarget": "admin:build:api",
          "proxyConfig": "apps/admin/proxy.api.json"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "api-types": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["SmartAgri.Api:build"],
      "inputs": [
        "{workspaceRoot}/apps/api/openapi/v1.json",
        {
          "externalDependencies": ["openapi-typescript"]
        }
      ],
      "outputs": ["{projectRoot}/src/app/core/api/api-schema.ts"],
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "openapi-typescript apps/api/openapi/v1.json -o apps/admin/src/app/core/api/api-schema.ts"
      }
    }
  }
}
