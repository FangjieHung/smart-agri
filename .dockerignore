# The api image is built with the repo root as context (deploy/docker-compose.yml);
# send only what the Dockerfile copies: the api's sources, and for the Node stage that builds the
# widget (M5a #201), the admin (#306) and the ordering app (#398) the workspace files (with .postcssrc.json,
# Tailwind for the admin), apps/widget, apps/admin, apps/shop, libs and the embed loader. Specs stay out: no build reads them.
*
!global.json
!apps/api/Directory.Build.props
!apps/api/Directory.Packages.props
!apps/api/src
!package.json
!package-lock.json
!.npmrc
!nx.json
!tsconfig.base.json
!.postcssrc.json
!apps/widget
!apps/admin
!apps/shop
!libs
!apps/embed-loader/src/embed.js
**/bin
**/obj
**/node_modules
**/dist
**/*.spec.ts
