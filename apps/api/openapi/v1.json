  "components": {
    "schemas": {
      "AccountPermission": {
        "enum": [
          "manage-assistants",
          "manage-data-sources",
          "manage-publishing",
          "read-consented-submissions",
          "use-shared-assistants",
          "submit-authorized-forms",
          "read-own-tracking"
        ]
      },
      "AccountRole": {
        "enum": [
          "smb-admin",
          "internal-employee",
          "external-customer"
        ]
      },
      "ApproveKnowledgeVersionsRequest": {
        "required": [
          "versionIds"
        ],
        "type": "object",
        "properties": {
          "versionIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "effectiveFrom": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": [
              "null",
              "string"
            ]
          },
          "newPassword": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateKnowledgeBaseRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "purpose": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DisableKnowledgeDocumentRequest": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "KnowledgeAccountView": {
        "required": [
          "id",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "KnowledgeActivityAction": {
        "enum": [
          "knowledge-base-created",
