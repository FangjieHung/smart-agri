<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      OpenAPI document generation at build time (M1 skeleton plan, Slice 7): the frontend's
      types are generated from apps/api/openapi/v1.json by Nx target admin:api-types, so the
      file is regenerated and committed on every API contract change (CI checks for drift,
      see .github/workflows/ci.yml).
    -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartAgri.Application\SmartAgri.Application.csproj" />
    <ProjectReference Include="..\SmartAgri.Infrastructure\SmartAgri.Infrastructure.csproj" />
    <ProjectReference Include="..\SmartAgri.Domain\SmartAgri.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Explicit reference so NuGet's normal version resolution (highest wins) applies
      instead of the ASP.NET Core shared framework's lower compile-time reference
      assembly winning as "primary" over the version SmartAgri.Infrastructure actually
      needs (Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 and
      Microsoft.EntityFrameworkCore.Design 10.0.12 do not pin the same
      Microsoft.EntityFrameworkCore patch).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenIddict server + validation (authorization code + PKCE); see Authentication/. -->
    <PackageReference Include="OpenIddict.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Built-in OpenAPI document generation (M1 skeleton plan §3, Slice 7): Microsoft.AspNetCore.OpenApi
      builds the document model; Microsoft.Extensions.ApiDescription.Server's build task writes
      apps/api/openapi/v1.json (OpenApiDocumentsDirectory above) on every build, which
      Nx target admin:api-types then turns into frontend types.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- OpenTelemetry traces/metrics/logs; see Observability/OpenTelemetryExtensions.cs. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <InternalsVisibleTo Include="SmartAgri.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The retrieval evaluation set (M2 plan, Slice 16): `eval-retrieval` and, with
      SEED_DEMO_KNOWLEDGE=true, DemoKnowledgeSeeder read it from eval/retrieval next to the
      assembly (RetrievalEvalSet.DefaultDirectory). Both are Development-only, so it is never
      published: the customer image has no use for it, and its build context does not even
      include apps/api/eval (the glob then matches nothing).
    -->
    <None Include="..\..\eval\retrieval\**\*" Exclude="..\..\eval\retrieval\generator\**;..\..\eval\retrieval\private\**;..\..\eval\retrieval\README.md;..\..\eval\retrieval\.gitattributes" LinkBase="eval\retrieval" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    Microsoft.Extensions.ApiDescription.Server's GenerateOpenApiDocuments target runs
    Program's entry point in-process (via HostFactoryResolver) up to WebApplicationBuilder.Build()
    to read endpoint metadata — no HTTP request is ever made and the app is never Run(). That
    still executes AddSmartAgriAuthentication(), which would otherwise refuse to start
    outside Development without real token certificates (TokenCredentials.Resolve). Rather
    than forcing this build's environment, Program.cs detects that generator process
    directly (SmartAgri.Api.OpenApi.BuildTimeOpenApi.IsGeneratingDocument) and gives it
    ephemeral keys unconditionally, regardless of $(ASPNETCORE_ENVIRONMENT) — see that
    type's remarks. EF Core/Npgsql never opens a connection just from DI registration
    either, so no Postgres needs to be running.

    dotnet-getdocument also names the generated file after the project
    ("SmartAgri.Api.json"), not the OpenAPI document name; the target below renames it to
    the committed v1.json (AddOpenApi()'s default document name is "v1", see Program.cs).
  -->
  <Target Name="RenameOpenApiDocument" AfterTargets="GenerateOpenApiDocuments"
      Condition=" Exists('$([System.IO.Path]::Combine($(OpenApiDocumentsDirectory), &quot;$(MSBuildProjectName).json&quot;))') ">
    <Move
        SourceFiles="$([System.IO.Path]::Combine($(OpenApiDocumentsDirectory), '$(MSBuildProjectName).json'))"
        DestinationFiles="$([System.IO.Path]::Combine($(OpenApiDocumentsDirectory), 'v1.json'))" />
  </Target>

</Project>
