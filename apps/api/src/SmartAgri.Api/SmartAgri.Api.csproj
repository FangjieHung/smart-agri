<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SmartAgri.Infrastructure\SmartAgri.Infrastructure.csproj" />
    <ProjectReference Include="..\SmartAgri.Domain\SmartAgri.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Explicit reference so NuGet's normal version resolution (highest wins) applies
      instead of the ASP.NET Core shared framework's lower compile-time reference
      assembly winning as "primary" over the version SmartAgri.Infrastructure actually
      needs (Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 and
      Microsoft.EntityFrameworkCore.Design 10.0.12 do not pin the same
      Microsoft.EntityFrameworkCore patch).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenTelemetry traces/metrics/logs; see Observability/OpenTelemetryExtensions.cs. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
  </ItemGroup>

</Project>
